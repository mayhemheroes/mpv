# .dockerignore for the commit-image build.
# Goal: bake in the FULL repo (including .git history — the grader uses it),
# dropping only local build artifacts and editor/OS cruft. Dev image, not minimal.

# ── Build outputs / local cruft (build.sh produces these INSIDE the image at build time;
#    keep any accidental host-side copies out of the context) ──────────────────────────
build/
ffmpeg-src/
ffmpeg-install/
fc_sysroot/
*.o
*.a
*.so
**/__pycache__/

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
